# Copy to .env and replace every value. Never commit .env.
DB_USER=vaxclinic
DB_PASSWORD=change-me-db-password
# host port for Postgres (change if 5432 is taken on your machine)
POSTGRES_PORT=5432
# >= 32 characters, shared by gateway + all services
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
RABBITMQ_USER=vaxclinic
RABBITMQ_PASSWORD=change-me-rabbit-password
MINIO_USER=vaxclinic
MINIO_PASSWORD=change-me-minio-password

# host port for API gateway (frontend calls this)
GATEWAY_PORT=8080

# 32-byte base64 key encrypting stored third-party passwords (tax portal, MISA). Never change after data exists.
ENCRYPTION_KEY=change-me-base64-32-bytes
