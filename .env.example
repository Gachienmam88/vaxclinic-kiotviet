ADMIN_PASSWORD=change-me-admin-password
RABBITMQ_USER=vaxclinic
RABBITMQ_PASSWORD=change-me-rabbit-password
MINIO_USER=vaxclinic
MINIO_PASSWORD=change-me-minio-password
